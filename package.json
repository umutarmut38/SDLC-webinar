{
  "name": "weekplan",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write README.md package.json index.html \"src/**/*.{ts,tsx,css}\" \"e2e/**/*.ts\" \"*.{ts,js}\" \".github/workflows/*.yml\"",
    "format:check": "prettier --check README.md package.json index.html \"src/**/*.{ts,tsx,css}\" \"e2e/**/*.ts\" \"*.{ts,js}\" \".github/workflows/*.yml\"",
    "validate": "npm run format:check && npm run lint && npm run test && npm run test:e2e && npm run typecheck && npm run build"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "9.35.0",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.3.1",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "9.35.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.20",
    "globals": "16.3.0",
    "jsdom": "26.1.0",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "4.1.6"
  }
}
